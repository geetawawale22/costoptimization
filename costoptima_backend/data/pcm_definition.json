  "profiles": {
    "forging": {
      "scope": "forging",
      "sheet": "Forging",
      "parameters": {
        "scrap_recovery_factor": 0.8
      },
      "operations": {},
      "steps": [
        {
          "name": "rate",
          "expression": "n(lookup(\"Material Master\", v(\"RM Base\", \"Rate/UOM\"), {\"Material Code\": v(\"Material Code\")}))"
        },
        {
          "name": "input_wt",
          "expression": "n(v(\"Input Wt\"))"
        },
        {
          "name": "part_wt",
          "expression": "n(v(\"Part Wt\"))"
        },
        {
          "name": "yield_ratio",
          "expression": "part_wt / input_wt"
        },
        {
          "name": "scrap_wt",
          "expression": "(input_wt - part_wt) * p(\"scrap_recovery_factor\")"
        },
        {
          "name": "scrap_rate",
          "expression": "n(lookup(\"Material Master\", \"Scrap Rate\", {\"Material Code\": v(\"Material Code\")}))"
        },
        {
          "name": "scrap_recovery",
          "expression": "scrap_wt * scrap_rate"
        },
        {
          "name": "heat",
          "expression": "(n(v(\"Heat Treatment Cost\")) if v(\"Heat Treatment Cost\", None) != None else operations(\"heat\")) if text(v(\"Type\")) == \"make\" else 0"
        },
        {
          "name": "rm_cost",
          "expression": "rate * input_wt + heat - scrap_recovery"
        },
        {
          "name": "process_cost",
          "expression": "n(v(\"Process Cost\")) if v(\"Process Cost\", None) != None else operations(\"conversion\")"
        },
        {
          "name": "basic_cost",
          "expression": "rm_cost + process_cost"
        },
        {
          "name": "icc_rate",
          "expression": "n(lookup(\"Norms Make\", \"ICC\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "icc_cost",
          "expression": "icc_rate * n(rule(\"Norms Make Applicability\", \"ICC Base\"))"
        },
        {
          "name": "rej_rate",
          "expression": "n(lookup(\"Norms Make\", \"REJ\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "rej_cost",
          "expression": "rej_rate * n(rule(\"Norms Make Applicability\", \"REJ Base\"))"
        },
        {
          "name": "oh_rate",
          "expression": "n(lookup(\"Norms Make\", \"OH\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "oh_cost",
          "expression": "oh_rate * n(rule(\"Norms Make Applicability\", \"OH Base\"))"
        },
        {
          "name": "profit_rate",
          "expression": "n(lookup(\"Norms Make\", \"PROFIT\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "profit_cost",
          "expression": "profit_rate * n(rule(\"Norms Make Applicability\", \"PROFIT Base\"))"
        },
        {
          "name": "markup",
          "expression": "icc_cost + rej_cost + oh_cost + profit_cost"
        },
        {
          "name": "total",
          "expression": "basic_cost + markup + n(v(\"Tool Cost\", 0)) + n(v(\"Packing\", 0)) + n(v(\"Freight\", 0))"
        }
      ],
      "outputs": {
        "RM Cost/Pc": "rm_cost",
        "Process Cost/Pc": "process_cost",
        "Basic Cost/Pc": "basic_cost",
        "ICC Cost": "icc_cost",
        "REJ Cost": "rej_cost",
        "OH Cost": "oh_cost",
        "Profit Cost": "profit_cost",
        "Total Markup": "markup",
        "Total": "total",
        "Yield (%)": "yield_ratio",
        "Scrap Wt": "scrap_wt",
        "Scrap Recovery": "scrap_recovery"
      }
    },
    "hard": {
      "scope": "trim",
      "sheet": "Make",
      "parameters": {
        "hrs_factor": 1.03,
        "shift_seconds": 28800,
        "deflashing_threshold": 400
      },
      "operations": {},
      "steps": [
        {
          "name": "rate",
          "expression": "n(lookup(\"Material Master\", v(\"RM Base\", \"Rate/UOM\"), {\"Material Code\": v(\"Material Code\")}))"
        },
        {
          "name": "gross_wt",
          "expression": "n(v(\"Gross Wt\")) if v(\"Gross Wt\", None) != None else n(v(\"Part Wt\")) * (p(\"hrs_factor\") if text(v(\"HRS Y or N\")) == \"y\" else n(band(\"Norms Gross Wt\", n(v(\"Part Wt\")), \"Factor\", {})))"
        },
        {
          "name": "rm_cost",
          "expression": "rate * gross_wt"
        },
        {
          "name": "efficiency",
          "expression": "n(lookup(\"Norms Make\", \"EFFICIENCY\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "shift_factor",
          "expression": "n(lookup(\"Norms Shift Factor\", \"Shift Factor\", {\"Process\": lookup(\"Material Master\", \"Applicable Process\", {\"Material Code\": v(\"Material Code\")}), \"Sector & Location\": v(\"Sector & Location\")}))"
        },
        {
          "name": "shift_rate",
          "expression": "n(v(\"m/c Tonnage\")) * shift_factor"
        },
        {
          "name": "pc_per_shift",
          "expression": "p(\"shift_seconds\") / n(v(\"Cycle Time\")) * n(v(\"Cavity\")) * efficiency"
        },
        {
          "name": "molding",
          "expression": "shift_rate / pc_per_shift"
        },
        {
          "name": "deflashing",
          "expression": "n(band(\"Norms Deflashing\", n(v(\"m/c Tonnage\")), \"Cost\", {})) if n(v(\"m/c Tonnage\")) > p(\"deflashing_threshold\") else 0"
        },
        {
          "name": "process_cost",
          "expression": "molding + deflashing"
        },
        {
          "name": "basic_cost",
          "expression": "rm_cost + process_cost"
        },
        {
          "name": "icc_rate",
          "expression": "n(lookup(\"Norms Make\", \"ICC\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "icc_cost",
          "expression": "icc_rate * n(rule(\"Norms Make Applicability\", \"ICC Base\"))"
        },
        {
          "name": "rej_rate",
          "expression": "n(lookup(\"Norms Make\", \"REJ\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "rej_cost",
          "expression": "rej_rate * n(rule(\"Norms Make Applicability\", \"REJ Base\"))"
        },
        {
          "name": "oh_rate",
          "expression": "n(lookup(\"Norms Make\", \"OH\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "oh_cost",
          "expression": "oh_rate * n(rule(\"Norms Make Applicability\", \"OH Base\"))"
        },
        {
          "name": "profit_rate",
          "expression": "n(lookup(\"Norms Make\", \"PROFIT\", {\"Supplier\": v(\"Supplier\")}))"
        },
        {
          "name": "profit_cost",
          "expression": "profit_rate * n(rule(\"Norms Make Applicability\", \"PROFIT Base\"))"
        },
        {
          "name": "markup",
          "expression": "icc_cost + rej_cost + oh_cost + profit_cost"
        },
        {
          "name": "total",
          "expression": "basic_cost + markup + n(v(\"Tool Cost\", 0)) + n(v(\"Packing\", 0)) + n(v(\"Freight\", 0))"
        }
      ],
      "outputs": {
        "RM Cost/Pc": "rm_cost",
        "Process Cost/Pc": "process_cost",
        "Basic Cost/Pc": "basic_cost",
        "ICC Cost": "icc_cost",
        "REJ Cost": "rej_cost",
        "OH Cost": "oh_cost",
        "Profit Cost": "profit_cost",
        "Total Markup": "markup",
        "Total": "total",
        "Gross Wt": "gross_wt",
        "Shift Factor": "shift_factor",
        "Shift Rate": "shift_rate",
        "Pc per shift": "pc_per_shift",
        "Molding Cost": "molding",
        "Deflashing Cost": "deflashing"
      }
    },
