{
  "material_master_lookup_family": "=IFERROR(VLOOKUP($I{row},'[1]Material Master'!$A:$SF,3,0),\"\")",
  "material_master_lookup_grade": "=IFERROR(VLOOKUP($I{row},'[1]Material Master'!$A:$SF,6,0),\"\")",
  "buy_std_basic_cost": "=IFERROR(VLOOKUP($D{row},'[1]BOP'!$D:$G,4,0),0)",
  "buy_std_total_pc": "=SUM({Basic Cost/Pc}{row}:{Profit}{row})",
  "pkg_frt_pnf_footer": "=IFERROR(SUMPRODUCT((${variant_col}$2:${variant_col}${data_last} ),( ${qty_col}$2:${qty_col}${data_last} ),( ${basic_cost_col}$2:${basic_cost_col}${data_last} ) ),0)",
  "variant_sum_footer": "=SUM(${variant_col}2:${variant_col}${data_last} )",
  "analysis_sum_master_output": "=IFERROR(SUM(Master_Output!${variant_col}:${variant_col}),0)",
  "end_item_analysis_sumproduct": "=IFERROR(SUMPRODUCT(Master_Output!${cost_col}${start_row}:${cost_col}${end_row},Master_Output!${variant_col}${start_row}:${variant_col}${end_row}),0)",
  "sbc_index_match": "=INDEX('End Item'!${value_range}, MATCH(SBC!${customer_cell}, 'End Item'!${customer_range}, 0), MATCH(SBC!${header_cell}, 'End Item'!${header_range}, 0))"
}
