          "expression": "profit_rate * n(rule(\"Norms Make Applicability\", \"PROFIT Base\"))"
        },
        {
          "name": "markup",
          "expression": "icc_cost + rej_cost + oh_cost + profit_cost"
        },
        {
          "name": "total",
          "expression": "basic_cost + markup + n(v(\"Tool Cost\", 0)) + n(v(\"Packing\", 0)) + n(v(\"Freight\", 0))"
        },
        {
