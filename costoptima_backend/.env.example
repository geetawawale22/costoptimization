# Copy to .env and adjust for your environment
DATABASE_URL=mysql+pymysql://costoptima:costoptima_pw@172.26.104.156:3306/costoptima

SECRET_KEY=replace-this-with-a-long-random-string
SESSION_EXPIRE_MINUTES=480
# Set to true once served over HTTPS in production (cookie requires a secure context)
SESSION_COOKIE_SECURE=false
# Must be an explicit origin (not "*") — session cookies require allow_credentials=True,
# which the browser will only honor for a named origin.
FRONTEND_ORIGIN=http://172.26.104.156:5173

UPLOAD_DIR=./uploads
LOG_DIR=./logs 
LOG_FILE=costoptima.log

# SSO remains optional at runtime, but this project is configured to show both
# normal login and CC Services SSO. SSO succeeds only when the SSO email already
# exists as an active CostOptima user.
SSO_ENABLED=true
SSO_LOGIN_URL=https://ccservices.mahindra.com/auth/login?id=afa93cde-c376-40dc-91fc-5bde44fad392&env=DEV
SSO_AUTO_CREATE_USERS=false
# CC Services currently returns an opaque/encrypted token, not always a JWT.
# Set this when CC Services shares the AES token decrypt key.
# Do not commit a real production secret to source control.
# SSO_TOKEN_DECRYPT_SECRET=replace-with-cc-services-aes-secret
#
# Alternative: set this to the CC Services endpoint that validates/decrypts
# jwt_token and returns JSON containing an employee_id/email claim.
# SSO_TOKEN_INFO_URL=https://ccservices.mahindra.com/auth/<token-validation-endpoint>
# SSO_TOKEN_INFO_METHOD=POST
# SSO_TOKEN_INFO_FIELD=jwt_token
# SSO_TOKEN_INFO_HEADER=
# Configure this if CC Services requires/accepts an explicit callback parameter.
# For LAN testing, set this to the machine/IP that CC Services can redirect to.
# If CC Services is registered only for localhost, SSO must be opened on the
# same machine running the backend, because localhost means "this browser's PC".
# SSO_CALLBACK_URL=http://172.26.104.156:8080/auth/sso/callback
