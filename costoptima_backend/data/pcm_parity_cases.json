{
  "_comment": [
    "Declarative legacy-parity regression cases for the PCM engine.",
    "",
    "Previously the only parity check lived inside tools/verify_pcm_reference.py with the",
    "file paths and the sheet/column comparison map written as Python literals. Adding a",
    "parity case for another commodity meant editing that script, which is exactly the",
    "hard-coded pattern this modernization is meant to remove - and it is the reason the",
    "project's largest remaining gap (independent input/output parity cases for Stamping,",
    "Soft, Forging, Sand, GDC, PDC, Thermal, PCBA and Seat) had no harness to run in.",
    "",
    "Add a new case by appending an object to \"cases\". No Python change is required.",
    "Paths are resolved relative to the backend root (the parent of this data/ folder).",
    "",
    "\"columns\" maps an engine result/output column name -> the column header in the",
    "expected legacy workbook. \"@variants\" means 'every variant named in the active",
    "definition's output.variants', which is how End Item / Analysis / SBC are compared.",
    "",
    "A comparison is skipped when the expected value is None, matching the original",
    "script's behaviour: the legacy workbook leaves non-applicable cells blank and those",
    "blanks are not assertions about a value."
  ],
  "cases": [
    {
      "name": "s302_bso_cover",
      "description": "S302 BSO COVER Sprint Input -> 2302C FENDER OUTER TRIMS expected output. Covers the Hard (Make), Buy Std, Assy and Special Process/Paint paths plus End Item, Analysis and SBC rollups.",
      "enabled": true,
      "definition": "data/pcm_reference_definition.json",
      "master_layout": "data/pcm_master_import.json",
      "input": "../S302 BSO COVER_Sprint Input_Rev 2_09.09.2026 (1).xlsx",
      "master": "../Master_Rate_Data.xlsx",
      "expected": "../2302C S302 FENDER OUTER TRIMS BC 10 Sep 2026 09.52.04 AM_50002264.xlsx",
      "tolerance": 1e-08,
      "scope": "Numerical core components, Paint aggregates/details, End Item variants, SBC and Analysis components; not exact workbook formatting or every legacy branch.",
      "profile_sheets": {
        "hard": {
          "sheet": "Make",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "columns": {
            "RM Cost/Pc": "RM Cost/Pc",
            "Process Cost/Pc": "Process Cost/Pc",
            "Basic Cost/Pc": "Basic Cost/Pc",
            "Total": "Total Cost/Pc",
            "ICC Cost": "ICC COST",
            "REJ Cost": "REJ COST",
            "OH Cost": "OH COST",
            "Profit Cost": "PROFIT COST",
            "Gross Wt": "Gross Wt",
            "Rate Kg": "Rate Kg",
            "Shift Rate": "Shift Rate",
            "Pc per shift": "Pc per shift"
          }
        },
        "buy_std": {
          "sheet": "Buy Std",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "columns": {
            "Basic Cost/Pc": "Basic Cost/Pc",
            "Total": "Total/Pc",
            "ICC Cost": "ICC Cost",
            "REJ Cost": "REJ Cost",
            "OH Cost": "O&H Cost",
            "Profit Cost": "PROFIT Cost"
          }
        },
        "assy": {
          "sheet": "Assy",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "columns": {
            "CT(sec)": "CT(sec)",
            "MHR": "MHR",
            "Basic Cost/Pc": "Basic cost/ pc",
            "Total": "Total",
            "CT Per Point": "CT Per Point",
            "Handling Time": "Handling Time"
          }
        },
        "special_process": {
          "sheet": "Special Process",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "columns": {
            "RM Cost/Pc": "Total RM Cost",
            "Process Cost/Pc": "Process Cost",
            "Basic Cost/Pc": "Basic cost",
            "Total": "Total cost /PC",
            "Total Markup": "MARKUP"
          }
        },
        "pkg": {
          "sheet": "Pkg",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "_comment": [
            "The pkg profile executes for this fixture but was previously never compared.",
            "Only the variant quantity columns and Qty/Veh are asserted here because they",
            "carry identical header names in both workbooks, so the mapping is evidence,",
            "not inference. The legacy sheet's 'Basic Cost'/'Markup' columns are NOT mapped",
            "to the engine's 'Total' - that equivalence is unproven while both sides are",
            "zero for this fixture. Needs Confirmation before asserting it.",
            "",
            "Note the engine writes this sheet as 'PKG' with the generic input-echo layout,",
            "while legacy writes 'Pkg' with a compact layout. That presentation difference",
            "is a real open gap; see docs/pcm/IMPLEMENTATION.md."
          ],
          "columns": {
            "Qty/Veh": "Qty/Veh",
            "MX 1": "MX 1",
            "MX 2": "MX 2",
            "MX 3": "MX 3",
            "MX 5": "MX 5",
            "MX 5[O]": "MX 5[O]",
            "AX 5": "AX 5",
            "AX 7": "AX 7",
            "AX7L": "AX7L",
            "ZENITH": "ZENITH"
          }
        },
        "frt": {
          "sheet": "Frt",
          "match_on": [
            "Customer No",
            "End Item"
          ],
          "_comment": "Same basis and same caveats as the pkg entry above.",
          "columns": {
            "Qty/Veh": "Qty/Veh",
            "MX 1": "MX 1",
            "MX 2": "MX 2",
            "MX 3": "MX 3",
            "MX 5": "MX 5",
            "MX 5[O]": "MX 5[O]",
            "AX 5": "AX 5",
            "AX 7": "AX 7",
            "AX7L": "AX7L",
            "ZENITH": "ZENITH"
          }
        }
      },
      "profile_details": {
        "special_process": {
          "expected_sheet": "Paint",
          "match_expected_column": "Customer No",
          "require_non_null_column": "Sr",
          "columns": {
            "Paint RM Cost": "Paint RM Cost",
            "Paint Process Cost": "Paint Process Cost",
            "Paint Basic Cost": "Basic Cost",
            "Paint Markup": "Paint Markup",
            "Paint PnF": "Pnf"
          }
        }
      },
      "rollups": [
        {
          "sheet": "End Item",
          "identity": "End Item",
          "columns": "@variants",
          "missing_actual_as_zero": true
        },
        {
          "sheet": "Analysis",
          "identity": "Cost Driver",
          "columns": "@variants",
          "missing_actual_as_zero": true
        },
        {
          "sheet": "SBC",
          "identity": "End Item",
          "columns": "@variants",
          "expected_header_row": 1,
          "expected_first_data_row": 2,
          "expected_require_non_null_index": 0,
          "_comment": "The legacy SBC sheet carries a display-label row (MX 1 / MX 2 ...) above its true header row."
        }
      ],
      "detail_sheets": [
        {
