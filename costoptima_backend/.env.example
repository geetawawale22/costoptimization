# Copy to .env and replace the placeholders for your local installation.
APP_ENV=development
CALCULATION_DEVELOPMENT_ENABLED=false
DATABASE_URL=mysql+pymysql://<account>:<url-encoded-password>@localhost:3306/costoptima?charset=utf8mb4
CSRF_SIGNING_KEY=<generate-at-least-64-random-characters>
TRUSTED_ORIGINS=http://127.0.0.1:5187,http://localhost:5187
COOKIE_SECURE=false
SESSION_HOURS=8
APP_CONFIG_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://127.0.0.1:5187

# Optional corporate SSO. Leave disabled until verified provider settings are available.
SSO_ENABLED=false
SSO_LOGIN_URL=
SSO_CALLBACK_URL=
SSO_TOKEN_INFO_URL=
SSO_TOKEN_INFO_METHOD=POST
SSO_TOKEN_INFO_FIELD=jwt_token
SSO_TOKEN_INFO_HEADER=
SSO_JWT_VERIFY=true
SSO_JWT_PUBLIC_KEY=
SSO_JWT_SECRET=
SSO_JWT_ALGORITHMS=RS256
SSO_JWT_ISSUER=
SSO_JWT_AUDIENCE=

# Optional external audit key; otherwise backend/.audit-signing-key is used.
AUDIT_SIGNING_KEY=
AUDIT_KEY_ID=v1
